# הטוקן שמקבלים מ-BotFather בטלגרם
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here

# מפתח API מ-console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# אופציונלי: הגבלת הבוט רק אליך (מזהה משתמש מספרי, אפשר כמה מופרדים בפסיק).
# את המזהה שלך אפשר לקבל מהבוט @userinfobot בטלגרם. ריק = פתוח לכל מי שמוצא את הבוט.
TELEGRAM_ALLOWED_USER_IDS=

# אופציונלי: מודל אחר (ברירת מחדל: claude-opus-5)
# CLAUDE_MODEL=claude-opus-5
